{
  "base": {
    "class": "desktop",
    "default_quality": "medium",
    "render": {
      "density": null,
      "msaa_high": 4,
      "bloom": [false, true, true],
      "shadows": [
        { "map": 512, "cascades": 1, "far": 40.0 },
        { "map": 1024, "cascades": 2, "far": 70.0 },
        { "map": 2048, "cascades": 3, "far": 110.0 }
      ],
      "frame_limit": null,
      "vsync": true
    },
    "debris": { "max_resting": 1500, "shadow_min_size": 0.8 },
    "lights": { "fire": [4, 6, 8], "flashes": 6 },
    "models": { "simplify": false, "detail": 1.0, "shadow_proxies": false, "texture_max": null },
    "prewarm": { "start_frames": 0, "wait_pipelines": false, "wait_limit": 2.0, "sync_compile": false },
    "threads": { "compute": null, "async_compute": null },
    "input": { "touch_default": false, "cursor": true, "rumble": true },
    "menu": { "quit": true },
    "audio": { "pause_in_background": false }
  },

  "desktop": { "parent": "base" },
  "macos": { "parent": "desktop" },
  "linux": { "parent": "desktop" },
  "windows": { "parent": "desktop" },

  "web": { "parent": "base", "menu": { "quit": false } },
  "web-desktop": { "parent": "web" },
  "web-mobile": {
    "parent": "web",
    "class": "phone",
    "default_quality": "low",
    "debris": { "max_resting": 600, "shadow_min_size": 1.2 },
    "lights": { "fire": [2, 3, 4], "flashes": 3 },
    "models": { "simplify": true, "shadow_proxies": true, "texture_max": 1024 }
  },

  "mobile": {
    "parent": "base",
    "class": "phone",
    "default_quality": "low",
    "render": {
      "density": [1.25, 1.5, 2.0],
      "shadows": [
        { "map": 512, "cascades": 1, "far": 40.0 },
        { "map": 1024, "cascades": 1, "far": 60.0 },
        { "map": 2048, "cascades": 2, "far": 70.0 }
      ]
    },
    "debris": { "max_resting": 600, "shadow_min_size": 1.2 },
    "lights": { "fire": [2, 3, 4], "flashes": 3 },
    "models": { "simplify": true, "shadow_proxies": true, "texture_max": 1024 },
    "prewarm": { "start_frames": 3 }
  },

  "android": {
    "parent": "mobile",
    "render": { "msaa_high": 1, "frame_limit": 60.0 },
    "prewarm": { "wait_pipelines": true },
    "threads": { "compute": 4, "async_compute": [2, 6] },
    "input": { "touch_default": true, "cursor": false, "rumble": false },
    "menu": { "quit": false },
    "audio": { "pause_in_background": true }
  },
  "android-low": {
    "parent": "android",
    "render": {
      "density": [1.0, 1.25, 1.5],
      "bloom": [false, false, false],
      "shadows": [
        { "map": 512, "cascades": 1, "far": 40.0 },
        { "map": 1024, "cascades": 1, "far": 50.0 },
        { "map": 1024, "cascades": 1, "far": 60.0 }
      ],
      "frame_limit": 30.0
    },
    "debris": { "max_resting": 300 },
    "lights": { "fire": [1, 2, 3], "flashes": 2 },
    "models": { "texture_max": 512 }
  },
  "android-high": {
    "parent": "android",
    "render": {
      "density": [1.5, 2.0, 2.5],
      "shadows": [
        { "map": 512, "cascades": 1, "far": 40.0 },
        { "map": 1024, "cascades": 2, "far": 70.0 },
        { "map": 2048, "cascades": 3, "far": 110.0 }
      ]
    },
    "debris": { "max_resting": 900 },
    "lights": { "fire": [3, 4, 6], "flashes": 4 }
  },

  "ios-phone": {
    "parent": "mobile",
    "input": { "touch_default": true, "cursor": false },
    "menu": { "quit": false },
    "audio": { "pause_in_background": true }
  },
  "ios-phone-low": {
    "parent": "ios-phone",
    "render": {
      "density": [1.0, 1.25, 1.5],
      "msaa_high": 1,
      "shadows": [
        { "map": 512, "cascades": 1, "far": 40.0 },
        { "map": 1024, "cascades": 1, "far": 50.0 },
        { "map": 1024, "cascades": 1, "far": 60.0 }
      ]
    },
    "debris": { "max_resting": 300 },
    "lights": { "fire": [1, 2, 3], "flashes": 2 },
    "models": { "texture_max": 512 }
  },
  "ios-phone-high": {
    "parent": "ios-phone",
    "default_quality": "medium",
    "render": {
      "density": [1.5, 2.0, 2.5],
      "shadows": [
        { "map": 512, "cascades": 1, "far": 40.0 },
        { "map": 1024, "cascades": 2, "far": 70.0 },
        { "map": 2048, "cascades": 3, "far": 110.0 }
      ]
    },
    "debris": { "max_resting": 800 },
    "lights": { "fire": [3, 4, 6], "flashes": 4 }
  },
  "ios-tablet": {
    "parent": "ios-phone",
    "class": "tablet",
    "default_quality": "medium",
    "render": { "density": [1.0, 1.5, 2.0], "frame_limit": 60.0 }
  },
  "ios-tablet-low": {
    "parent": "ios-tablet",
    "default_quality": "low",
    "render": {
      "density": [1.0, 1.25, 1.5],
      "msaa_high": 1,
      "shadows": [
        { "map": 512, "cascades": 1, "far": 40.0 },
        { "map": 1024, "cascades": 1, "far": 50.0 },
        { "map": 1024, "cascades": 1, "far": 60.0 }
      ]
    },
    "debris": { "max_resting": 300 },
    "lights": { "fire": [1, 2, 3], "flashes": 2 },
    "models": { "texture_max": 512 }
  },
  "ios-tablet-high": {
    "parent": "ios-tablet",
    "render": {
      "density": [1.5, 2.0, 2.0],
      "shadows": [
        { "map": 512, "cascades": 1, "far": 40.0 },
        { "map": 1024, "cascades": 2, "far": 70.0 },
        { "map": 2048, "cascades": 3, "far": 110.0 }
      ]
    },
    "debris": { "max_resting": 1000 },
    "lights": { "fire": [4, 6, 8], "flashes": 6 }
  }
}
