<?xml version="1.0" encoding="utf-8"?>
<!-- Game Mode (Android 12+): игра сама поддерживает режимы «производительность» и «экономия батареи»
     (src/android.rs, `GameManager.getGameMode`), поэтому вмешательства системы — ANGLE вместо драйвера,
     уменьшение кадра, подмена частоты кадров — ей не нужны. -->
<game-mode-config xmlns:android="http://schemas.android.com/apk/res/android"
    android:supportsBatteryGameMode="true"
    android:supportsPerformanceGameMode="true"
    android:allowGameAngleDriver="false"
    android:allowGameDownscaling="false"
    android:allowGameFpsOverride="false" />
