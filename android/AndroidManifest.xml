<?xml version="1.0" encoding="utf-8"?>
<!-- Версии и уровни SDK подставляет scripts/build-android.sh. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.zotausiarhei.spaceguard">

    <uses-feature android:name="android.hardware.vulkan.version"
        android:version="0x401000" android:required="true" />

    <application
        android:label="Space Guard"
        android:icon="@mipmap/ic_launcher"
        android:appCategory="game"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hasCode="false"
        android:extractNativeLibs="false">
        <!-- Профилирование simpleperf без root (ключ app у simpleperf record). -->
        <profileable android:shell="true" />
        <!-- Режимы Game Mode, которые игра поддерживает сама (res/xml/game_mode_config.xml). -->
        <meta-data android:name="android.game_mode_config" android:resource="@xml/game_mode_config" />
        <!-- enableOnBackInvokedCallback="false": с target SDK 36 «назад» иначе закрывает игру сам,
             а она делает из неё Esc (src/gamepad/android.rs). -->
        <!-- configChanges: всё, что меняется посреди игры, обрабатывает сама игра. Иначе система
             пересоздала бы активность, а вторая активность в живом процессе завершает его (main.rs):
             смена оператора в роуминге (mcc|mnc) обрывала бы забег. -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:enableOnBackInvokedCallback="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/SpaceGuard"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale|mcc|mnc|touchscreen|colorMode|fontWeightAdjustment|grammaticalGender">
            <meta-data android:name="android.app.lib_name" android:value="space_guard" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
