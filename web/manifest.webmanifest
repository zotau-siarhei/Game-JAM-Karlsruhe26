{
  "name": "Space Guard",
  "short_name": "Space Guard",
  "description": "Top-down arcade shooter: a lunar rover defends a planet. Survive as long as you can.",
  "start_url": "./?source=app",
  "scope": "./",
  "display": "fullscreen",
